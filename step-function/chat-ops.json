{
  "Comment": "ChatOps provisioning workflow, webhook-driven. Account 676278186770, us-east-1. Terraform runs are triggered by the GitHub webhook on Terraform-pipeline.",
  "StartAt": "Route by Method",
  "States": {
    "Route by Method": {
      "Type": "Choice",
      "Comment": "Choice with IsPresent is the ONLY safe way to read a field that may be absent.",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.requestContext.http.method",
              "IsPresent": true
            },
            {
              "Variable": "$.requestContext.http.method",
              "StringEquals": "POST"
            }
          ],
          "Next": "Task: Parse Chat Input"
        },
        {
          "And": [
            {
              "Variable": "$.httpMethod",
              "IsPresent": true
            },
            {
              "Variable": "$.httpMethod",
              "StringEquals": "POST"
            }
          ],
          "Next": "Task: Parse Chat Input"
        },
        {
          "And": [
            {
              "Variable": "$.requestContext.http.method",
              "IsPresent": true
            },
            {
              "Variable": "$.requestContext.http.method",
              "StringEquals": "DELETE"
            }
          ],
          "Next": "Task: Delete Resource by ID"
        },
        {
          "And": [
            {
              "Variable": "$.httpMethod",
              "IsPresent": true
            },
            {
              "Variable": "$.httpMethod",
              "StringEquals": "DELETE"
            }
          ],
          "Next": "Task: Delete Resource by ID"
        },
        {
          "And": [
            {
              "Variable": "$.requestContext.http.method",
              "IsPresent": true
            },
            {
              "Variable": "$.requestContext.http.method",
              "StringEquals": "GET"
            }
          ],
          "Next": "Task: Fetch Provisioned Resources"
        },
        {
          "And": [
            {
              "Variable": "$.httpMethod",
              "IsPresent": true
            },
            {
              "Variable": "$.httpMethod",
              "StringEquals": "GET"
            }
          ],
          "Next": "Validate Status Query"
        }
      ],
      "Default": "Unknown Action Error"
    },
    "Task: Fetch Provisioned Resources": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:query",
      "Parameters": {
        "TableName": "aws-ops-resources",
        "KeyConditionExpression": "request_id = :id",
        "ExpressionAttributeValues": {
          ":id": {
            "S.$": "$.queryStringParameters.request_id"
          }
        }
      },
      "ResultPath": "$.queryResult",
      "TimeoutSeconds": 15,
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "Bad Request Error"
        }
      ],
      "Next": "Validate Status Query"
    },
    "Validate Status Query": {
      "Type": "Choice",
      "Comment": "Guards the DynamoDB query.",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.queryStringParameters",
              "IsPresent": true
            },
            {
              "Variable": "$.queryStringParameters.request_id",
              "IsPresent": true
            }
          ],
          "Next": "End: Status Returned"
        }
      ],
      "Default": "Bad Request Error"
    },
    "End: Status Returned": {
      "Type": "Succeed"
    },
    "Task: Parse Chat Input": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:676278186770:function:ChatOps-Input-Parser",
        "Payload.$": "$"
      },
      "ResultSelector": {
        "parsed.$": "$.Payload"
      },
      "ResultPath": "$.parsedInput",
      "TimeoutSeconds": 30,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 4,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "ValidationError"
          ],
          "ResultPath": "$.error",
          "Next": "Bad Request Error"
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "Notify Failure"
        }
      ],
      "Next": "Choice: Resource Type?"
    },
    "Choice: Resource Type?": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.parsedInput.parsed.resource_type",
          "StringEquals": "ec2",
          "Next": "Task: Provision EC2"
        },
        {
          "Variable": "$.parsedInput.parsed.resource_type",
          "StringEquals": "s3",
          "Next": "Task: Provision S3"
        }
      ],
      "Default": "Unsupported Resource Error"
    },
    "Task: Provision EC2": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:676278186770:function:ChatOps-EC2-Processor",
        "Payload": {
          "parsedInput.$": "$.parsedInput.parsed"
        }
      },
      "ResultSelector": {
        "result.$": "$.Payload"
      },
      "ResultPath": "$.provisioningResult",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 4,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        },
        {
          "ErrorEquals": [
            "GitHubConflict"
          ],
          "IntervalSeconds": 3,
          "MaxAttempts": 5,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "Notify Failure"
        }
      ],
      "Next": "End: Config Pushed to GitHub"
    },
    "Task: Provision S3": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:676278186770:function:ChatOps-S3-Processor",
        "Payload": {
          "parsedInput.$": "$.parsedInput.parsed"
        }
      },
      "ResultSelector": {
        "result.$": "$.Payload"
      },
      "ResultPath": "$.provisioningResult",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 4,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        },
        {
          "ErrorEquals": [
            "GitHubConflict"
          ],
          "IntervalSeconds": 3,
          "MaxAttempts": 5,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "Notify Failure"
        }
      ],
      "Next": "End: Config Pushed to GitHub"
    },
    "Task: Delete Resource by ID": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:676278186770:function:ChatOps-Delete-Resource",
        "Payload.$": "$"
      },
      "ResultSelector": {
        "result.$": "$.Payload"
      },
      "ResultPath": "$.deleteExecutionResult",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 4,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        },
        {
          "ErrorEquals": [
            "GitHubConflict"
          ],
          "IntervalSeconds": 3,
          "MaxAttempts": 5,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "Notify Failure"
        }
      ],
      "Next": "Was Resource Found?"
    },
    "Was Resource Found?": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.deleteExecutionResult.result.status",
          "StringEquals": "DESTROY_QUEUED",
          "Next": "End: Destroy Queued"
        }
      ],
      "Default": "End: Nothing To Delete"
    },
    "End: Nothing To Delete": {
      "Type": "Succeed"
    },
    "Notify Failure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:676278186770:function:ChatOps-Notifier",
        "Payload": {
          "outcome": "FAILED",
          "error.$": "$.error",
          "execution.$": "$$.Execution.Name",
          "input.$": "$"
        }
      },
      "ResultPath": "$.notifyResult",
      "TimeoutSeconds": 30,
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Provisioning Failed"
        }
      ],
      "Next": "Provisioning Failed"
    },
    "Provisioning Failed": {
      "Type": "Fail",
      "Error": "ProvisioningFailed",
      "Cause": "The request could not be completed. See the execution history and the FAILED record in DynamoDB."
    },
    "Bad Request Error": {
      "Type": "Fail",
      "Error": "BadRequest",
      "Cause": "The request payload was missing required fields or could not be parsed."
    },
    "Unknown Action Error": {
      "Type": "Fail",
      "Error": "UnknownAction",
      "Cause": "The requested HTTP method is unsupported."
    },
    "Unsupported Resource Error": {
      "Type": "Fail",
      "Error": "UnsupportedResource",
      "Cause": "The resource type requested is invalid. Supported: ec2, s3."
    },
    "End: Config Pushed to GitHub": {
      "Type": "Succeed"
    },
    "End: Destroy Queued": {
      "Type": "Succeed"
    }
  }
}
